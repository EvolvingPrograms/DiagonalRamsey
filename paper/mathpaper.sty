\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathpaper}[2026/10/30 Shared mathematics paper style]

% Use with \documentclass[11pt]{amsart}.
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[letterpaper,margin=1.15in]{geometry}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{microtype,booktabs}
\RequirePackage[hidelinks,pdfusetitle]{hyperref}
% AMS uses the optional short title in headers; retain the full PDF title.
\AtBeginDocument{\hypersetup{pdftitle={\@title}}}

\raggedbottom
\numberwithin{equation}{section}
\setcounter{secnumdepth}{1}
\hyphenation{Section Sections}
\g@addto@macro{\UrlBreaks}{\do\_}

\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}
