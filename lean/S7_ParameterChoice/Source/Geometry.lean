theorem entries_length : entries.length = count := by decide

def row (i : Fin count) : Row := entries[i.val]'(by simpa only [entries_length] using i.isLt)
def geom (i : Fin count) : ControlGeometry.Cell := ⟨(row i).lo, (row i).hi, 0, 0⟩
def cell (i : Fin count) : SourceCell (Fin SourceProfiles.count) :=
  .pair (row i).red (row i).blue

def cover : SourceCoverData (Fin SourceProfiles.count) (Fin count) :=
  ⟨SourceTails.leftEnd, SourceTails.rightStart, List.finRange count, geom, cell⟩

set_option maxHeartbeats 0 in
theorem chain : ControlGeometry.chain cover.left (cover.rows.map cover.geom) cover.right = true := by
  decide +kernel

theorem nonempty : cover.rows.map cover.geom ≠ [] := by decide
theorem left_eq : cover.left = SourceTails.leftEnd := rfl
theorem right_eq : cover.right = SourceTails.rightStart := rfl

/-- Every interior ratio belongs to a row of the finite source cover. -/
theorem coverage {t : ℝ} (ht : t ∈ Set.Icc (SourceTails.leftEnd : ℝ) SourceTails.rightStart) :
    ∃ i : Fin count, (row i).lo ≤ t ∧ t ≤ (row i).hi := by
  obtain ⟨C, hC, htC⟩ := ControlGeometry.chain_real_cover chain nonempty ht
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hC
  exact ⟨i, htC⟩

#print axioms chain
#print axioms coverage

