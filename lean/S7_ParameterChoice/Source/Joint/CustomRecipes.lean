def recipes : Fin 5 → RawD JointFamily.ProfileIndex 5 2716 := ![route458, route516, route533, route599, route600]

def slot : Fin 5 → JointFamily.RawIndex := ![1462, 1466, 1467, 1468, 1463]

theorem checked (i : Fin 5) : (recipes i).check controls JointFamily.sourceAq JointFamily.sourceBq
    JointFamily.datum (.inl 0) (JointFamily.rawDatum (slot i)) = true := by
  fin_cases i
  · exact checked458
  · exact checked516
  · exact checked533
  · exact checked599
  · exact checked600

theorem recipe_bounds : ∀ i : Fin 5,
    (recipes i).lo = (JointFamily.rawDatum (slot i)).xs.headD 0 ∧
    (recipes i).hi = (JointFamily.rawDatum (slot i)).xs.getLastD 0 := by decide +kernel

/-- **Custom proper-host implication.** Each custom route uses only the
joint induction's assertions on proper subhosts. All terminal controls and
finite recipe inequalities are proved above. -/
theorem proper_host_piece (i : Fin 5) : ∃ K,
    PieceOK JointFamily.raw JointFamily.closed JointFamily.A JointFamily.B
      (JointFamily.raw (slot i)) (JointFamily.raw (slot i)).lo (JointFamily.raw (slot i)).hi K := by
  obtain ⟨K, hK⟩ := (recipes i).pieceOK controls controls_cert JointFamily.sourceAq JointFamily.sourceBq
    (fun j => (JointFamily.source_coefficients_pos j).1)
    (fun j => (JointFamily.source_coefficients_pos j).2)
    JointFamily.datum JointFamily.raw JointFamily.closed JointFamily.profile_eq
    JointFamily.raw_valid JointFamily.closed_valid (.inl 0)
    (JointFamily.rawDatum (slot i)) (JointFamily.raw_valid (slot i)) (checked i)
  refine ⟨K, ?_⟩
  rw [(recipe_bounds i).1, (recipe_bounds i).2] at hK
  exact hK

/-- A custom route supplies every knot interval of its output profile. -/
theorem custom_piece_ok (i : Fin 5) (j : Fin (nRP (slot i))) : ∃ K,
    PieceOK JointFamily.raw JointFamily.closed JointFamily.A JointFamily.B
      (JointFamily.raw (slot i)) (rpLo (slot i) j) (rpHi (slot i) j) K := by
  obtain ⟨K, hK⟩ := proper_host_piece i
  exact ⟨K, pieceOK_restrict (raw_interval_bounds _ _).1 (raw_interval_bounds _ _).2 hK⟩

