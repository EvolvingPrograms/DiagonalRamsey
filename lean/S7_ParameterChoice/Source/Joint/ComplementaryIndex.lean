def entries : List Entry :=
  baseEntries ++ block0 ++ block1 ++ block2 ++ block3 ++ block4 ++ block5 ++ block6 ++ block7 ++ block8 ++ block9 ++ block10 ++ block11 ++ block12 ++ block13 ++ block14 ++ block15 ++ block16 ++ block17 ++ block18 ++ block19

theorem entries_length : entries.length = 510 := by decide +kernel
theorem pieces_count : (entries.map (fun e => e.window.count-1)).sum = 1685 := by decide +kernel

abbrev Index := Fin 510

def entry (i : Index) : Entry := entries[i.val]'(by rw [entries_length]; exact i.isLt)
def window (i : Index) : AlignedWindow := (entry i).window
def redIndex (i : Index) : JointFamily.RawIndex :=
  ⟨(entry i).redId.val, by have := (entry i).redId.isLt; omega⟩
def blueIndex (i : Index) : JointFamily.RawIndex :=
  ⟨(entry i).blueId.val, by have := (entry i).blueId.isLt; omega⟩
def closedIndex (i : Index) : JointFamily.ClosedIndex := (entry i).closedId
def nPieces (i : Index) : ℕ := (window i).count-1

theorem rawDatum_red (i : Index) :
    JointFamily.rawDatum (redIndex i) = (JointData.rawDatum (entry i).redId).toD := by
  unfold redIndex
  rw [JointFamily.rawDatum, dif_pos (entry i).redId.isLt]

theorem rawDatum_blue (i : Index) :
    JointFamily.rawDatum (blueIndex i) = (JointData.rawDatum (entry i).blueId).toD := by
  unfold blueIndex
  rw [JointFamily.rawDatum, dif_pos (entry i).blueId.isLt]

theorem closed_geometry (i : Index) : PL.sortedQ (JointData.closedDatum (closedIndex i)).toD.xs = true := by
  have hf : (JointData.closedDatum (closedIndex i)).ok (JointData.closedMinimum (closedIndex i)) = true :=
    List.all_eq_true.mp JointData.closed_checked _
      (List.getElem_mem (show (closedIndex i).val < JointData.closedEntries.length from (closedIndex i).isLt))
  have h := ProfF.ok_imp _ _ hf
  simp only [ProfD.ok, Bool.and_eq_true, decide_eq_true_eq] at h
  exact h.1.1.1.1.2

#print axioms closed_geometry
#print axioms pieces_count

end DiagonalRamsey.JointComplementary
