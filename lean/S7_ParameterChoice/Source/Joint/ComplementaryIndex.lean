import S7_ParameterChoice.Source.Joint.Complementary
import S7_ParameterChoice.Source.Joint.FastClosed

/-! Exact complementary donors, common breakpoint lists, and original
knot windows. Generated by `757.closed-compression.py` from the hashed bank. -/

set_option autoImplicit false
set_option maxRecDepth 100000

namespace DiagonalRamsey.JointComplementary

open DiagRamsey DiagRamsey.V5 JointGeometry

structure Entry where
  redId : Fin 1462
  blueId : Fin 1462
  closedId : Fin 947
  window : AlignedWindow
  breakpoints : List FQ

def donors (e : Entry) : Fin 2 → ProfF
  | ⟨0, _⟩ => JointData.rawDatum e.redId
  | ⟨_+1, _⟩ => JointData.rawDatum e.blueId

def certificate (e : Entry) : ClosedPF 2 :=
  .complRaw 0 1 e.window.lo e.window.hi e.breakpoints

def entryCheck (e : Entry) : Bool :=
  (certificate e).check (donors e) (JointData.closedDatum e.closedId) &&
    e.window.coversKnots (JointData.closedDatum e.closedId) &&
    decide (e.window.startQ+e.window.count ≤ (JointData.closedDatum e.closedId).toD.xs.length)

