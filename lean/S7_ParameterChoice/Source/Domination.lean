/-- Historical indices follow lexicographically ordered source IDs; the
stored name and coefficients are read together from the exact bank source. -/
def source (i : Fin count) : Entry :=
  entries[i.val]'(by rw [entries_length]; exact i.isLt)

theorem source_valid (i : Fin count) : (source i).Valid := by
  have hm : source i ∈ entries := List.getElem_mem _
  exact of_decide_eq_true (List.all_eq_true.mp checked (source i) hm)

/-- **Historical source domination.** On the nonnegative axis the selected
hull line is below every source line stored in the historical bank. -/
theorem historical_bound (i : Fin count) {t : ℝ} (ht : 0 ≤ t) :
    SourceHull.line (SourceHull.selector t) t ≤
      ((source i).A : ℝ) + ((source i).B : ℝ) * t :=
  (source i).bound (source_valid i) ht

#print axioms checked
