import S7_ParameterChoice.Source.Hull

set_option autoImplicit false
set_option maxRecDepth 100000

namespace DiagonalRamsey.SourceDomination

/-- An original source ID and its exact coefficients, together with two
hull indices and a convex weight. This data asserts no source admissibility. -/
structure Entry where
  name : String
  A : ℚ
  B : ℚ
  left : Fin 130
  right : Fin 130
  weight : ℚ

def Entry.Valid (d : Entry) : Prop :=
  0 ≤ d.weight ∧ d.weight ≤ 1 ∧
  d.weight * SourceHull.A d.left + (1 - d.weight) * SourceHull.A d.right ≤ d.A ∧
  d.weight * SourceHull.B d.left + (1 - d.weight) * SourceHull.B d.right ≤ d.B

instance (d : Entry) : Decidable d.Valid := by unfold Entry.Valid; infer_instance

/-- **Coefficient certificate.** A rational convex-combination certificate
transfers the selected hull minimum to the original source line. -/
theorem Entry.bound (d : Entry) (hc : d.Valid) {t : ℝ} (ht : 0 ≤ t) :
    SourceHull.line (SourceHull.selector t) t ≤ (d.A : ℝ) + (d.B : ℝ) * t := by
  apply SourceEnvelope.affine_minorant_of_two
    (SourceHull.selected_le t d.left) (SourceHull.selected_le t d.right)
    (w := (d.weight : ℝ))
  · exact_mod_cast hc.1
  · exact_mod_cast hc.2.1
  · exact_mod_cast hc.2.2.1
  · exact_mod_cast hc.2.2.2
  · exact ht

