theorem heights_length : heights.length = cells + 1 := by decide

/-- Uniform knots spanning the certified cutoff through the upper degree. -/
def knot (i : Fin (cells + 1)) : ℚ :=
  degreeCutoff + (μ - degreeCutoff) * (i.val : ℚ) / cells

def height (i : Fin (cells + 1)) : ℚ :=
  heights[i.val]'(by simpa only [heights_length] using i.isLt)

def midpoint (i : Fin cells) : ℚ := (knot i.castSucc + knot i.succ) / 2

/-- **Cell checks.** These are finite rational interval obligations, shared
by every cell. Acceptance must still be proved before the table supplies
a control certificate. -/
def CellChecks (i : Fin cells) : Prop :=
  (budget (midpoint i)).safe (point 0) = true ∧
  ControlExpr.upper (budget (midpoint i)) < 0 ∧
  (bindingGap (midpoint i)).safe (point 0) = true ∧
  0 < ControlExpr.lower (bindingGap (midpoint i)) ∧
  (tangent (midpoint i) (knot i.castSucc)).safe (point 0) = true ∧
  ControlExpr.upper (tangent (midpoint i) (knot i.castSucc)) ≤ height i.castSucc ∧
  (tangent (midpoint i) (knot i.succ)).safe (point 0) = true ∧
  ControlExpr.upper (tangent (midpoint i) (knot i.succ)) ≤ height i.succ

/-- The complete numerical obligation is one uniformly indexed family. -/
def AllCellsChecked : Prop := ∀ i : Fin cells, CellChecks i

#print axioms heights_length

