def rows : List Row := [row0, row1, row2, row3, row4, row5, row6, row7, row8, row9, row10, row11, row12, row13, row14, row15, row16, row17, row18, row19, row20, row21, row22, row23, row24, row25, row26, row27, row28, row29, row30, row31, row32]

theorem rows_valid : rows.all Row.valid = true := by
  simp only [rows, List.all_cons, List.all_nil, valid0, valid1, valid2, valid3, valid4, valid5, valid6, valid7, valid8, valid9, valid10, valid11, valid12, valid13, valid14, valid15, valid16, valid17, valid18, valid19, valid20, valid21, valid22, valid23, valid24, valid25, valid26, valid27, valid28, valid29, valid30, valid31, valid32, Bool.true_and]

theorem rows_global {r : Row} (hr : r ∈ rows) :
    ∀ t ∈ controlDomain, controlH t ≤ (r.m : ℝ)*t+r.c := by
  have h := List.all_eq_true.mp rows_valid r hr
  simp only [Row.valid, Bool.and_eq_true] at h
  exact checked_tangent h.1 h.2

theorem lines_matched : ControlGeometry.degreeCells.all (fun D =>
    rows.any (fun r => decide (r.m = D.slope ∧ r.c = D.intercept))) = true := by
  decide +kernel

theorem degree_lines_bound : ∀ D ∈ ControlGeometry.degreeCells,
    ∀ t ∈ controlDomain, controlH t ≤ (D.slope : ℝ)*t+D.intercept := by
  intro D hD t ht
  have h := List.all_eq_true.mp lines_matched D hD
  obtain ⟨r, hr, he⟩ := List.any_eq_true.mp h
  simp only [decide_eq_true_eq] at he
  simpa only [he.1, he.2] using rows_global hr t ht

#print axioms degree_lines_bound
end RamseyAnalytic.TangentExpressions
