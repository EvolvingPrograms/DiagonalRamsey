def childCellCheck (j : Fin 17) (D : Cell) : Bool := decide (
  knotsQ j.castSucc ≤ D.left ∧ D.right ≤ knotsQ j.succ ∧ D.left ≤ D.right ∧
  D.slope*D.left+D.intercept < heightQ D.left ∧
  D.slope*D.right+D.intercept < heightQ D.right)

theorem child_chains : ∀ j, chain (knotsQ j.castSucc) (childCells j) (knotsQ j.succ) = true := by
  decide +kernel
theorem child_nonempty : ∀ j, childCells j ≠ [] := by decide +kernel
theorem child_checked : ∀ j, (childCells j).all (childCellCheck j) = true := by
  decide +kernel

#print axioms child_chains
#print axioms child_checked
end RamseyAnalytic.CandidateRoute
