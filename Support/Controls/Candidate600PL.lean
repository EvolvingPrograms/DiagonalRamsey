theorem exact_cells : outputCells.all (ExactPLProfileBridge.cellCheck nodes values) = true := by
  decide +kernel
theorem profile_eq {r : ℝ} (hr : r ∈ Icc (lo : ℝ) (hi : ℝ)) :
    PL.evalR nodes values r = CandidateRoute.evalPieces outputCells r :=
  ExactPLProfileBridge.evalR_eq_evalPieces output_chain output_nonempty exact_cells hr
theorem output_valid {n : ℕ} (A B : Fin n → ℝ) (i : Fin n)
    (hApos : ∀ j, 0 < A j) (hBpos : ∀ j, 0 < B j)
    (hcontrol : (RetainedControl.control control i).Valid A B)
    (hchildren : ∀ j, RelValidPr (fun K V _ _ => Prem A B K V)
      (data.density j) (data.u j.castSucc) (data.u j.succ)
      (CandidateRoute.evalPieces (data.cells j))) :
    RelValid A B (data.p : ℝ) lo hi (PL.evalR nodes values) := by
  apply ExactPLProfileBridge.relative output_chain output_nonempty exact_cells
  exact Candidate600Prefix.output_valid A B i hApos hBpos hcontrol hchildren
