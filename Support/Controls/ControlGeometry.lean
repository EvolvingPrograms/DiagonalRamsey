def cutoff : ℚ := (704669676406336391752074361351463 / 248362000000000000000000000000 : ℚ)
def tailBound : ℚ := (-29754512159540994928363408920377303115589537 / 125000000000000000000000000000000000000000 : ℚ)

def chain : ℚ → List Cell → ℚ → Bool
  | left, [], right => decide (left = right)
  | left, cell :: rest, right =>
      decide (cell.left = left ∧ cell.left < cell.right) && chain cell.right rest right

def corner (D I : Cell) (q u : ℚ) : Bool :=
  decide ((D.slope+w-w*u)*q+D.intercept ≤ I.slope*u+I.intercept)

def corners (D I : Cell) : Bool :=
  corner D I D.left I.left && corner D I D.right I.left &&
  corner D I D.left I.right && corner D I D.right I.right

theorem degree_chain : chain 0 degreeCells mu = true := by decide +kernel
theorem integral_chain : chain 0 integralCells cutoff = true := by decide +kernel
theorem degree_nonneg : degreeCells.all (fun D => decide (0 ≤ D.left ∧ 0 ≤ D.right)) = true := by decide +kernel
theorem all_corners : integralCells.all (fun I => degreeCells.all (fun D => corners D I)) = true := by decide +kernel
theorem tail_corners : degreeCells.all (fun D =>
    decide ((D.slope+w-w*cutoff)*D.left+D.intercept ≤ tailBound ∧
      (D.slope+w-w*cutoff)*D.right+D.intercept ≤ tailBound)) = true := by decide +kernel

#print axioms degree_chain
#print axioms integral_chain
#print axioms degree_nonneg
#print axioms all_corners
#print axioms tail_corners
end RamseyAnalytic.ControlGeometry
