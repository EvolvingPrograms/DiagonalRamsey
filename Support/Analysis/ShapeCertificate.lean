/-! Exact polynomial shape certificates. The sufficient polynomial condition
`1 - t * Q(t) > 0` is stronger than the manuscript's shape condition; it
removes transcendental numerical evaluation by `1 + t ≤ exp t`.

All rational coefficients and shifts below are untrusted generated data.
Their identities, interval bounds and finite coverage are kernel checked.
-/

set_option autoImplicit false
set_option maxRecDepth 20000
set_option maxHeartbeats 0

namespace AnalyticBounds.ShapeCertificate

open Polynomial Set FixedPointInterval

def ratBound (r : ℚ) : Interval :=
  divNat (point (r.num * scale)) r.den

theorem ratBound_sound (r : ℚ) : (ratBound r).Contains (r : ℝ) := by
  have hp : (point (r.num * scale)).Contains (r.num : ℝ) := by
    simpa [value, scale] using Interval.contains_point (r.num * scale)
  simpa [ratBound, Rat.cast_def] using hp.divNat r.den_pos

def rationalSpan (a b : ℚ) : Interval :=
  ⟨(ratBound a).lo, (ratBound b).hi⟩

theorem rationalSpan_sound {a b : ℚ} {x : ℝ}
    (hx : (a : ℝ) ≤ x ∧ x ≤ (b : ℝ)) : (rationalSpan a b).Contains x :=
  ⟨(ratBound_sound a).1.trans hx.1, hx.2.trans (ratBound_sound b).2⟩

noncomputable def hornerEval : List ℚ → ℝ → ℝ
  | [], _ => 0
  | a :: cs, x => (a : ℝ) + x * hornerEval cs x

noncomputable def hornerPoly : List ℚ → Polynomial ℝ
  | [] => 0
  | a :: cs => C (a : ℝ) + X * hornerPoly cs

theorem hornerPoly_eval (cs : List ℚ) (x : ℝ) :
    (hornerPoly cs).eval x = hornerEval cs x := by
  induction cs with
  | nil => simp [hornerPoly, hornerEval]
  | cons a cs ih => simp [hornerPoly, hornerEval, ih]

def hornerBound : List ℚ → Interval → Interval
  | [], _ => point 0
  | a :: cs, I => add (ratBound a) (mul I (hornerBound cs I))

theorem hornerBound_sound (cs : List ℚ) {I : Interval} {x : ℝ}
    (hx : I.Contains x) : (hornerBound cs I).Contains (hornerEval cs x) := by
  induction cs with
  | nil => simpa [hornerBound, hornerEval, value] using Interval.contains_point 0
  | cons a cs ih => exact (ratBound_sound a).add (hx.mul ih)

def centeredHornerBound (cs : List ℚ) (a b c : ℚ) : Interval :=
  hornerBound cs (rationalSpan (a-c) (b-c))

theorem centeredHorner_pos (cs : List ℚ) (a b c : ℚ) {x : ℝ}
    (hx : (a : ℝ) ≤ x ∧ x ≤ (b : ℝ))
    (hcheck : checkLower (centeredHornerBound cs a b c) 0 = true) :
    0 < hornerEval cs (x - (c : ℝ)) := by
  have hd : (rationalSpan (a-c) (b-c)).Contains (x-(c : ℝ)) := by
    apply rationalSpan_sound
    push_cast
    constructor <;> linarith [hx.1, hx.2]
  have h := value_lt_of_checkLower hcheck (hornerBound_sound cs hd)
  simpa [value] using h

noncomputable def curvaturePolynomial (P : Polynomial ℝ) : Polynomial ℝ :=
  (X-C 2)*P + (C 2-C 2*X)*P.derivative + X*P.derivative.derivative

noncomputable def sufficientShapePolynomial (P : Polynomial ℝ) : Polynomial ℝ :=
  1-X*curvaturePolynomial P

theorem shapeOmega_pos_of_sufficientPolynomial {P : Polynomial ℝ} {x : ℝ}
    (hx : 0 ≤ x) (hpoly : 0 < (sufficientShapePolynomial P).eval x) :
    0 < shapeOmega P x := by
  have hexp : 0 ≤ Real.exp x - (1+x) := by
    linarith [Real.add_one_le_exp x]
  have hmain : 0 < (Real.exp x-(1+x)) +
      (1+x)*(sufficientShapePolynomial P).eval x :=
    add_pos_of_nonneg_of_pos hexp (mul_pos (by linarith) hpoly)
  have heq : Real.exp x * shapeOmega P x =
      (Real.exp x-(1+x)) + (1+x)*(sufficientShapePolynomial P).eval x := by
    simp only [shapeOmega, correctionCurvature, sufficientShapePolynomial,
      curvaturePolynomial, eval_sub, eval_add, eval_mul, eval_one, eval_X, eval_C]
    rw [Real.exp_neg]
    field_simp [ne_of_gt (Real.exp_pos x)]
    ring
  rw [← heq] at hmain
  exact (mul_pos_iff_of_pos_left (Real.exp_pos x)).mp hmain

