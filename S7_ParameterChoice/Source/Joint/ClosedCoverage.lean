theorem rows_checked : rows.all rowCheck = true := by
  simp only [rows, List.all_append, rows0_checked, rows1_checked, rows2_checked, rows3_checked, rows4_checked, rows5_checked, rows6_checked, rows7_checked, rows8_checked, rows9_checked, rows10_checked, rows11_checked, rows12_checked, rows13_checked, rows14_checked, rows15_checked, rows16_checked, rows17_checked, rows18_checked, rows19_checked, rows20_checked, rows21_checked, rows22_checked, rows23_checked, rows24_checked, rows25_checked, rows26_checked, rows27_checked, rows28_checked, rows29_checked, Bool.and_true]

/-- **Finite partition coverage.** Every original closed interval belongs
to a checked run with the same closed-profile index. -/
theorem covers (i : ClosedIndex) (j : Fin (nCP i)) :
    ∃ r : Run, r.closedIndex = i ∧ r.start ≤ j.val ∧ j.val < r.start + r.count := by
  have hi : i ∈ rows.map Prod.fst := by rw [rows_indices]; exact List.mem_finRange i
  obtain ⟨⟨k, rs⟩, hmem, he⟩ := List.mem_map.mp hi
  have hk : k = i := he
  subst k
  have hc : chain i 0 rs = true := List.all_eq_true.mp rows_checked _ hmem
  obtain ⟨r, _, hr, hlo, hhi⟩ := chain_covers hc (Nat.zero_le _) j.isLt
  exact ⟨r, hr, hlo, hhi⟩

theorem pieces_exist (i : ClosedIndex) (j : Fin (nCP i)) :
    ∃ pc : ClosedPiece 1469, pc.Valid raw (closed i) (cpLo i j) (cpHi i j) := by
  obtain ⟨r, hi, hlo, hhi⟩ := covers i j
  subst i
  exact ⟨r.piece, r.valid j hlo hhi⟩

/-- **Unified closed recipe.** Select an already checked recipe for each
original knot interval; this is the closed-piece input to joint induction. -/
noncomputable def closedRecipe (i : ClosedIndex) (j : Fin (nCP i)) : ClosedPiece 1469 :=
  Classical.choose (pieces_exist i j)

theorem closedRecipe_valid (i : ClosedIndex) (j : Fin (nCP i)) :
    (closedRecipe i j).Valid raw (closed i) (cpLo i j) (cpHi i j) :=
  Classical.choose_spec (pieces_exist i j)

