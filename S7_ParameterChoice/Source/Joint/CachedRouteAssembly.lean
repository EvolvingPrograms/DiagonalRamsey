theorem all_checked : entries.all (fun e => e.toEntry.check) = true := by
  apply List.all_eq_true.mpr
  intro e he
  exact e.check_imp expTable expTable_checked (List.all_eq_true.mp all_fast_checked e he)

theorem checked (i : Index) : (entry i).toEntry.check = true :=
  List.all_eq_true.mp all_checked _ (List.getElem_mem _)

/-- A balanced inverse identifies the original pair of every generated row.
Only its values on the 825 checked entries matter. -/
