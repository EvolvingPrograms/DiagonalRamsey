  apply List.Nodup.of_map inv
  rw [List.map_map]
  exact h.symm ▸ List.nodup_range

theorem distinct_original_indices : (entries.map (fun e => (e.rawIndex.val, e.piece))).Nodup :=
  nodup_of_inverse entries (fun e => (e.rawIndex.val, e.piece)) provenanceInverse 825 provenance_inverse

theorem bounds_checked (i : Index) : (entry i).toEntry.boundsCheck = true :=
  (Bool.and_eq_true_iff.mp (checked i)).2

theorem pieceOK (i : Index) : ∃ K, DiagRamsey.PieceOK raw closed A B (raw (entry i).rawIndex)
    (JointRecipes.rpLo (entry i).rawIndex ((entry i).toEntry.pieceIndex (bounds_checked i)))
    (JointRecipes.rpHi (entry i).rawIndex ((entry i).toEntry.pieceIndex (bounds_checked i))) K :=
  (entry i).toEntry.pieceOK (Bool.and_eq_true_iff.mp (checked i)).1 (bounds_checked i)

def Covered (r : RawIndex) (j : Fin (JointRecipes.nRP r)) : Prop :=
  ∃ i : Index, (entry i).rawIndex = r ∧ (entry i).piece = j.val

theorem covered_pieceOK (r : RawIndex) (j : Fin (JointRecipes.nRP r)) (h : Covered r j) :
    ∃ K, DiagRamsey.PieceOK raw closed A B (raw r) (JointRecipes.rpLo r j) (JointRecipes.rpHi r j) K := by
  obtain ⟨i, hr, hj⟩ := h
  subst r
  have he : (entry i).toEntry.pieceIndex (bounds_checked i) = j := Fin.ext hj
  obtain ⟨K, hK⟩ := pieceOK i
  exact ⟨K, he ▸ hK⟩

#print axioms all_checked
#print axioms distinct_original_indices
#print axioms covered_pieceOK
end DiagonalRamsey.JointCachedRoutes
