set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace DiagonalRamsey.JointLeaf
open DiagRamsey DiagRamsey.V5 JointGeometry JointFamily

structure Entry where
  rawId : Fin 1464
  terminalId : TerminalIndex
  margin : FQ
  window : AlignedWindow
  breakpoints : List FQ

def Entry.profile (e : Entry) : ProfF := fastProfile e.rawId
def Entry.rawIndex (e : Entry) : RawIndex := familyIndex e.rawId
def Entry.terminal (e : Entry) : Terminal := JointLeaf.terminal e.terminalId
def Entry.leaf (e : Entry) : LeafF 1 2716 :=
  ⟨e.terminal.data, e.margin, e.window.lo, e.window.hi, e.breakpoints⟩
def Entry.check (e : Entry) : Bool :=
  e.leaf.geometryCheck e.terminal.controls bCoefficients e.profile &&
    e.window.coversKnots e.profile &&
    decide (e.window.startQ+e.window.count ≤ e.profile.toD.xs.length)

