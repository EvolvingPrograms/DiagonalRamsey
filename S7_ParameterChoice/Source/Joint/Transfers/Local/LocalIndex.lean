def entries : List Entry :=
  baseEntries ++ block0 ++ block1 ++ block2 ++ block3 ++ block4 ++ block5 ++ block6 ++ block7 ++ block8 ++ block9 ++ block10 ++ block11 ++ block12 ++ block13 ++ block14 ++ block15 ++ block16 ++ block17 ++ block18 ++ block19 ++ block20 ++ block21 ++ block22

theorem entries_length : entries.length = 430 := by decide +kernel

theorem pieces_count : (entries.map (fun e => e.window.count-1)).sum = 5812 := by decide +kernel

abbrev Index := Fin 430

def entry (i : Index) : Entry := entries[i.val]'(by rw [entries_length]; exact i.isLt)
def window (i : Index) : AlignedWindow := (entry i).window
def rawIndex (i : Index) : JointFamily.RawIndex :=
  ⟨(entry i).rawId.val, by have := (entry i).rawId.isLt; omega⟩
def closedIndex (i : Index) : JointFamily.ClosedIndex := (entry i).closedId
def nPieces (i : Index) : ℕ := (window i).count-1

theorem rawDatum_eq (i : Index) :
    JointFamily.rawDatum (rawIndex i) = (JointData.rawDatum (entry i).rawId).toD := by
  unfold rawIndex
  rw [JointFamily.rawDatum, dif_pos (entry i).rawId.isLt]

/-- Previously checked full-profile geometry supplies the trimming hypotheses. -/
theorem raw_geometry (i : Index) :
    PL.sortedQ (JointData.rawDatum (entry i).rawId).toD.xs = true ∧
      (JointData.rawDatum (entry i).rawId).toD.xs.length =
        (JointData.rawDatum (entry i).rawId).toD.ys.length := by
  obtain ⟨m,h⟩ := JointRecipes.raw_datum_ok (rawIndex i)
  rw [rawDatum_eq] at h
  simp only [ProfD.ok, Bool.and_eq_true, decide_eq_true_eq] at h
  exact ⟨h.1.1.1.1.2, h.1.1.1.1.1.2⟩

theorem closed_geometry (i : Index) :
    PL.sortedQ (JointData.closedDatum (closedIndex i)).toD.xs = true ∧
      (JointData.closedDatum (closedIndex i)).toD.xs.length =
        (JointData.closedDatum (closedIndex i)).toD.ys.length := by
  have hf : (JointData.closedDatum (closedIndex i)).ok (JointData.closedMinimum (closedIndex i)) = true :=
    List.all_eq_true.mp JointData.closed_checked _
      (List.getElem_mem (show (closedIndex i).val < JointData.closedEntries.length from (closedIndex i).isLt))
  have h := ProfF.ok_imp _ _ hf
  simp only [ProfD.ok, Bool.and_eq_true, decide_eq_true_eq] at h
  exact ⟨h.1.1.1.1.2, h.1.1.1.1.1.2⟩

#print axioms raw_geometry
#print axioms closed_geometry
#print axioms pieces_count

end DiagonalRamsey.JointLocal
