def fastProfile (i : Fin 1464) : ProfF :=
  if h : i.val < 1462 then JointData.rawDatum ⟨i.val, h⟩
  else JointData.appendedRawDatum ⟨i.val-1462, by omega⟩

def familyIndex (i : Fin 1464) : RawIndex :=
  if h : i.val < 1462 then ⟨i.val, by omega⟩ else ⟨i.val+2, by omega⟩

theorem datum_eq (i : Fin 1464) : rawDatum (familyIndex i) = (fastProfile i).toD := by
  unfold familyIndex fastProfile
  split_ifs with h
  · rw [JointFamily.rawDatum, dif_pos h]
  · simp only [JointFamily.rawDatum]
    rw [dif_neg (by omega), if_neg (by omega), if_neg (by omega), dif_pos (by omega)]
    congr 2

