theorem crossings_length : crossings.length = 129 := by decide

def crossing (j : Fin 129) : ℚ :=
  crossings[j.val]'(by rw [crossings_length]; exact j.isLt)

def Checks : Prop :=
  (∀ j : Fin 129, B j.succ < B j.castSucc ∧ 0 ≤ crossing j ∧
    A j.castSucc + B j.castSucc * crossing j = A j.succ + B j.succ * crossing j) ∧
  (∀ j : Fin 128, crossing j.castSucc < crossing j.succ)

instance : Decidable Checks := by unfold Checks; infer_instance

set_option maxHeartbeats 0 in
theorem checked : Checks := by decide +kernel

def line (i : Fin 130) (t : ℝ) : ℝ := A i + B i * t

theorem slope_step (j : Fin 129) : (B j.succ : ℝ) ≤ B j.castSucc := by
  exact_mod_cast (checked.1 j).1.le

theorem crossing_nonneg (j : Fin 129) : (0 : ℝ) ≤ crossing j := by
  exact_mod_cast (checked.1 j).2.1

theorem crossing_strictMono : StrictMono crossing :=
  Fin.strictMono_iff_lt_succ.mpr checked.2

theorem crossing_values (j : Fin 129) :
    line j.castSucc (crossing j) = line j.succ (crossing j) := by
  unfold line
  exact_mod_cast (checked.1 j).2.2

private def UpperCondition (t : ℝ) (k : ℕ) : Prop :=
  k < 130 ∧ ∀ j : Fin 129, k ≤ j.val → t ≤ (crossing j : ℝ)

private theorem upperCondition_exists (t : ℝ) : ∃ k, UpperCondition t k := by
  refine ⟨129, by norm_num, ?_⟩
  intro j hj
  omega

/-- **Hull selector.** Choose the first line whose upper crossings are all
at least `t`. A finite switch belongs to the line on its left. -/
noncomputable def selector (t : ℝ) : Fin 130 := by
  classical
  exact ⟨Nat.find (upperCondition_exists t), (Nat.find_spec (upperCondition_exists t)).1⟩

theorem selector_right (t : ℝ) (j : Fin 129) (hj : selector t ≤ j.castSucc) :
    t ≤ (crossing j : ℝ) := by
  classical
  exact (Nat.find_spec (upperCondition_exists t)).2 j hj

theorem selector_left (t : ℝ) (j : Fin 129) (hj : j.castSucc < selector t) :
    (crossing j : ℝ) < t := by
  classical
  by_contra h
  have ht : t ≤ (crossing j : ℝ) := le_of_not_gt h
  have hc : UpperCondition t j.val := by
    refine ⟨by omega, ?_⟩
    intro k hjk
    have horder : (crossing j : ℝ) ≤ crossing k := by
      exact_mod_cast crossing_strictMono.monotone hjk
    exact ht.trans horder
  have hmin : (selector t).val ≤ j.val := Nat.find_min' (upperCondition_exists t) hc
  exact (not_lt_of_ge hmin) hj

/-- **Selected hull minimum.** The actual selected line lies below all
130 hull lines, by adjacent comparisons and finite-chain transitivity. -/
theorem selected_le (t : ℝ) : ∀ j : Fin 130, line (selector t) t ≤ line j t := by
  apply finite_chain_minimum (fun j => line j t) (selector t)
  · intro j hj
    exact affine_le_right_tail (selector_left t j hj).le (slope_step j) (crossing_values j).ge
  · intro j hj
    exact affine_le_left_tail (selector_right t j hj) (slope_step j) (crossing_values j).le

#print axioms checked
#print axioms crossing_strictMono
#print axioms selected_le

end DiagonalRamsey.SourceHull
