theorem supportIndices_length : supportIndices.length = 172 := by decide
theorem supportNames_length : supportNames.length = 172 := by decide

def support (i : Fin 172) : Index :=
  supportIndices[i.val]'(by rw [supportIndices_length]; exact i.isLt)

set_option maxHeartbeats 0 in
/-- Each support index has its original profile ID, including all 91 reused entries. -/
theorem support_name : ∀ i : Fin 172,
    name (support i) = supportNames[i.val]'(by rw [supportNames_length]; exact i.isLt) := by
  decide +kernel

theorem support_valid (i : Fin 172) : (profile (support i)).Valid := valid (support i)

