/-- Reused profiles occupy the left summand; only new data occupy the right. -/
abbrev Index := Fin SourceProfiles.count ⊕ Fin 81

noncomputable def profile : Index → BankProfile :=
  Sum.elim SourceProfiles.profile (fun i => (extraDatum i).toBP)

def name : Index → String := Sum.elim SourceProfiles.name extraName

/-- The original 114 profiles embed without copying or changing any curve. -/
def reuse : Fin SourceProfiles.count ↪ Index := ⟨Sum.inl, Sum.inl_injective⟩

theorem profile_reuse (i : Fin SourceProfiles.count) :
    profile (reuse i) = SourceProfiles.profile i := rfl

theorem name_reuse (i : Fin SourceProfiles.count) :
    name (reuse i) = SourceProfiles.name i := rfl

/-- **Geometric validity.** Every reused or additional curve has the PL
positivity and domain properties required by the joint construction.
This theorem does not establish any profile's Ramsey assertion. -/
theorem valid (i : Index) : (profile i).Valid := by
  cases i with
  | inl i => exact SourceProfiles.valid i
  | inr i => exact extra_valid i

