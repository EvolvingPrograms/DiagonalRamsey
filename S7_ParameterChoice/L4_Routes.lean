theorem newProfiles_checked (i : Fin 5) : (newDatum i).ok (1/10) = true := by
  fin_cases i <;> decide +kernel

theorem raw_valid (i : RawIndex) : (raw i).Valid := by
  unfold raw rawDatum
  split_ifs with h
  · exact JointFamily.raw_valid ⟨i.val, h⟩
  · exact ProfD.valid_of_ok _ _ (newProfiles_checked _)

theorem profile_eq (i : ProfileIndex) : profile i = (datum i).toBP := by
  cases i <;> rfl

def oldIndex (i : JointFamily.RawIndex) : RawIndex := ⟨i.val, by omega⟩

theorem old_profile (i : JointFamily.RawIndex) : raw (oldIndex i) = JointFamily.raw i := by
  simp only [raw, rawDatum, oldIndex, Fin.isLt, dif_pos, JointFamily.raw]

def newIndex (i : Fin 5) : RawIndex := ⟨1469 + i.val, by omega⟩

theorem new_datum (i : Fin 5) : rawDatum (newIndex i) = newDatum i := by
  simp only [rawDatum, newIndex]
  rw [dif_neg (by omega)]
  congr 1
  apply Fin.ext
  simp

def childRoute : Fin 4 → RouteD ProfileIndex 1 2716 :=
  ![childRoute0, childRoute1, childRoute2, childRoute3]

theorem child_checked (i : Fin 4) :
    (childRoute i).check (fun _ => childControl) JointFamily.sourceAq JointFamily.sourceBq
      datum (.inl 0) (newDatum ⟨i.val, by omega⟩) = true := by
  fin_cases i
  · exact child_checked0
  · exact child_checked1
  · exact child_checked2
  · exact child_checked3

/-- Each new child has its complete proper-host route, using the actual
467 control and the canonically indexed 606 source. -/
theorem child_pieceOK (i : Fin 4) : ∃ K,
    PieceOK raw JointFamily.closed JointFamily.A JointFamily.B
      (raw (newIndex ⟨i.val, by omega⟩))
      (raw (newIndex ⟨i.val, by omega⟩)).lo
      (raw (newIndex ⟨i.val, by omega⟩)).hi K := by
  let j : Fin 5 := ⟨i.val, by omega⟩
  obtain ⟨K, hK⟩ := (RawD.route (childRoute i)).pieceOK (fun _ => childControl)
    (fun _ => childControl_cert) JointFamily.sourceAq JointFamily.sourceBq
    (fun s => (JointFamily.source_coefficients_pos s).1)
    (fun s => (JointFamily.source_coefficients_pos s).2)
    datum raw JointFamily.closed profile_eq raw_valid JointFamily.closed_valid
    (.inl 0) (newDatum j) (ProfD.valid_of_ok _ _ (newProfiles_checked j)) (child_checked i)
  change PieceOK raw JointFamily.closed JointFamily.A JointFamily.B _ _ _ K at hK
  have hb : (childRoute i).lo = (newDatum j).xs.headD 0 ∧
      (childRoute i).hi = (newDatum j).xs.getLastD 0 := by
    fin_cases i <;> decide +kernel
  change ∃ K, PieceOK raw JointFamily.closed JointFamily.A JointFamily.B
    (raw (newIndex j)) (raw (newIndex j)).lo (raw (newIndex j)).hi K
  simp only [raw, new_datum]
  refine ⟨K, ?_⟩
  simpa only [RawD.lo, RawD.hi, hb.1, hb.2, ProfD.toBP, JointFamily.A, JointFamily.B] using hK

/-- The chosen complementary envelope closes the twelve-call root. No old
scalar certificate is assumed for the retuned control. -/
theorem root_pieceOK : ∃ K,
    PieceOK raw JointFamily.closed JointFamily.A JointFamily.B
      (raw (newIndex 4)) (raw (newIndex 4)).lo (raw (newIndex 4)).hi K := by
  obtain ⟨K, hK⟩ := ComplementRoutes.route_pieceOK (fun _ => rootControl)
    (fun _ => rootControl_envelope) JointFamily.sourceAq JointFamily.sourceBq
    (fun s => (JointFamily.source_coefficients_pos s).1)
    (fun s => (JointFamily.source_coefficients_pos s).2)
    datum raw JointFamily.closed profile_eq raw_valid JointFamily.closed_valid
    (.inl 0) rootDatum (ProfD.valid_of_ok _ _ (newProfiles_checked 4)) rootRoute root_checked
  change PieceOK raw JointFamily.closed JointFamily.A JointFamily.B _ _ _ K at hK
  have hb : rootRoute.lo = rootDatum.xs.headD 0 ∧
      rootRoute.hi = rootDatum.xs.getLastD 0 := by decide +kernel
  change ∃ K, PieceOK raw JointFamily.closed JointFamily.A JointFamily.B
    rootDatum.toBP rootDatum.toBP.lo rootDatum.toBP.hi K
  refine ⟨K, ?_⟩
  simpa only [hb.1, hb.2, ProfD.toBP, JointFamily.A, JointFamily.B] using hK

#print axioms child_pieceOK
#print axioms root_pieceOK

